# Server
PORT=8001
INTERNAL_SECRET=change-me

# R2 / S3-compatible
R2_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=stanat

# 워터마크(장소명/촬영시각) 번인에 쓸 한글 지원 폰트 파일 경로
# Docker/Linux 기본값: /usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
# Windows 로컬 테스트 예시: C:\Windows\Fonts\malgun.ttf (맑은 고딕, 기본 내장)
WATERMARK_FONT_PATH=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc

# Job 상태 저장소
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
